rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── IDENTIDAD ───────────────────────────────────────────
       Tres niveles que determinan toda la política de acceso:
       - esPublico(): NO hay sesión en Firebase Authentication
         (visitante sin cuenta): el visitante navega sin
         autenticarse y NO genera ningún registro en Firebase
         Authentication (cero fantasmas). Solo puede LEER el
         catálogo publicado y el contenido de prueba (acceso no
         restringido); nunca escribe.
       - isRegistered(): cualquier cuenta real de Firebase Auth
         (correo/contraseña o Google). Acceso completo al contenido.
       - isAdmin()/isGestor(): roles de gestión (superadmin/gestor).
       La identidad anónima automática fue ELIMINADA: un visitante
       sin sesión equivale a request.auth == null.                  */
    function signedIn() {
      return request.auth != null;
    }
    // Visitante sin sesión en Firebase Authentication. Sustituye al
    // antiguo login anónimo automático: navegación 100 % local, cero
    // registros fantasma en Auth.
    function esPublico() {
      return request.auth == null;
    }
    function isRegistered() {
      return signedIn();
    }
    /* ─── ROLES MÚLTIPLES (Fase A) ────────────────────────────────
       El documento usuarios/{uid} guarda el rol PRINCIPAL en `rol`
       (heredado: estudiante | avanzado | gestor | superadmin) y el
       conjunto COMPLETO en `roles` (arreglo, que además admite los roles
       nuevos: superadmin, cursos_pago, coordinador_comunidad, comptable).

       El conjunto efectivo es la UNIÓN de ambos, y es lo que se consulta
       aquí. Esa unión es lo que hace la migración segura: los documentos
       antiguos (que solo tienen `rol`) siguen valiendo igual, y uno que
       solo tenga `roles` también cuenta.

       `exists()` + `get()` sobre el MISMO documento cuentan como un solo
       acceso (el motor cachea la lectura dentro de la evaluación), así que
       estas comprobaciones no gastan del presupuesto de 10 accesos.

       OJO: un documento inexistente o sin `roles` NO concede ningún
       permiso: `miUsuarioExiste()` lo corta antes de tocar `.data`, que
       sobre null LANZARÍA error y denegaría la expresión entera. */
    function miUsuarioExiste() {
      return isRegistered()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function misRoles() {
      // `roles` debe ser una LISTA: un documento editado a mano podría
      // guardar otra cosa ahí, y llamar a hasAny() sobre un valor que no es
      // lista LANZARÍA error (y un error en las reglas deniega). Se cae a
      // lista vacía: un campo corrupto NO concede ningún rol.
      return miUsuarioExiste()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('roles', []) is list
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('roles', [])
        : [];
    }
    function miRol() {
      return miUsuarioExiste()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '')
        : '';
    }
    // ¿La sesión tiene ese rol? Vale tanto si viene del rol principal como
    // si viene del arreglo `roles`.
    function tieneRol(r) {
      return miUsuarioExiste() && (miRol() == r || misRoles().hasAny([r]));
    }
    function isAdmin() {
      return tieneRol('superadmin');
    }
    function isGestor() {
      return tieneRol('gestor');
    }
    // Rol "avanzado": perfil de solo lectura sobre la propia red. NO gestiona
    // contenido (canManage() lo excluye a propósito) y NO tiene bypass: no
    // aparece en las reglas de escritura de finanzas.
    function esAvanzado() {
      return tieneRol('avanzado');
    }
    // Rol "contable" (Fase A): acceso al módulo de finanzas y a los reportes
    // financieros. El superadmin lo cubre por bypass (isAdmin()).
    function esContable() {
      return tieneRol('contable');
    }
    // Rol "coordinador de comunidad" (Fase A): vista de la red MLM
    // jerárquica de 4 niveles sobre SU propia red.
    function esCoordinador() {
      return tieneRol('coordinador_comunidad');
    }
    // Rol "cursos de pago" (Fase A): acceso al contenido y a los cursos
    // prémium.
    function esCursosPago() {
      return tieneRol('cursos_pago');
    }

    /* ─── RED JERÁRQUICA: EL CAMPO `camino` (Fase A) ──────────────
       Cada documento usuarios/{uid} guarda `camino`: el ARREGLO de sus
       ancestros de patrocinio, DEL MÁS CERCANO AL MÁS LEJANO, con un
       máximo de 4 entradas (los 4 niveles de la vista del coordinador).

       El dato NO es declarativo del cliente: la escritura lo valida
       contra la cadena REAL de patrocinio (caminoCoherente()), de modo que
       nadie puede inventarse un árbol ni colarse en la red de otro
       coordinador. Gracias a eso, un coordinador lee SU red con UNA sola
       consulta: where('camino','array-contains',uid). */
    // Patrocinador (sponsorId) de un usuario, o '' si el documento no
    // existe o no tiene patrocinador. Una sola lectura por documento (el
    // motor cachea el get() dentro de la misma evaluación).
    function sponsorDe(uid) {
      return uid is string && uid != ''
        && get(/databases/$(database)/documents/usuarios/$(uid)) != null
        ? get(/databases/$(database)/documents/usuarios/$(uid)).data.get('sponsorId', '')
        : '';
    }
    // El `camino` que se escribe debe ser COHERENTE con la cadena real de
    // patrocinio: camino[0] es el patrocinador directo del documento y cada
    // eslabón siguiente es el patrocinador del anterior (hasta 4 niveles).
    // Si el documento no trae `camino` (documentos heredados) no hay nada que
    // validar: el índice se reconstruye desde el panel del superadmin.
    //
    // OJO: el lenguaje de reglas NO tiene sentencias `if`: solo expresiones
    // booleanas (con && / || de CORTO CIRCUITO) y el operador ternario.
    // Por eso todo se resuelve como una sola cadena de condiciones: los
    // && cortan en falso, así que los get() de sponsorDe() solo se ejecutan
    // cuando los eslabones anteriores ya son válidos.
    function caminoCoherente() {
      return !('camino' in request.resource.data)
        || (request.resource.data.camino is list
            && request.resource.data.camino.size() <= 4
            && (request.resource.data.camino.size() == 0
                || (request.resource.data.camino[0] is string
                    && request.resource.data.camino[0] != ''
                    && request.resource.data.get('sponsorId', '') == request.resource.data.camino[0]
                    && (request.resource.data.camino.size() < 2
                        || (request.resource.data.camino[1] is string
                            && sponsorDe(request.resource.data.camino[0]) == request.resource.data.camino[1]))
                    && (request.resource.data.camino.size() < 3
                        || (request.resource.data.camino[2] is string
                            && sponsorDe(request.resource.data.camino[1]) == request.resource.data.camino[2]))
                    && (request.resource.data.camino.size() < 4
                        || (request.resource.data.camino[3] is string
                            && sponsorDe(request.resource.data.camino[2]) == request.resource.data.camino[3])))));
    }
    // Gestores y superadmin gestionan el contenido del CMS.
    // OJO con el ORDEN: la comprobación del correo va PRIMERO a propósito.
    // isGestor()/isAdmin() hacen get(usuarios/{uid}).data.rol, y si ese
    // documento no existe `.data` vale null y `.rol` sobre null LANZA error; en
    // las reglas un error propaga y deniega la expresión entera, así que un || al
    // final nunca llegaría a evaluarse. Con el correo primero, el atajo se
    // resuelve sin tocar Firestore y las cuentas de gestión por rol siguen igual.
    function canManage() {
      return (signedIn() && request.auth.token.email == 'convocacion@gmail.com')
        || isGestor()
        || isAdmin();
    }
    // Permiso explícito del CRM para vincular una tienda externa. Se lee del
    // propio documento usuarios/{uid} (fuente única de permisos) y usa get()
    // con valor por defecto: un documento/campo ausente NO debe lanzar error
    // ni conceder el permiso. El superadmin conserva el bypass de siempre.
    function esVendedorAutorizado() {
      return isRegistered()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('vendedorAutorizado', false) == true;
    }
    // ═══ ALCANCE DE LA RED DEL ROL AVANZADO ═════════════════════
    // El avanzado NO lee la base completa: solo los documentos financieros
    // cuyo titular (campo `userId`) es él mismo o un descendiente suyo de
    // hasta 5 niveles. Para comprobarlo hay que SUBIR desde el titular del
    // documento (las reglas no pueden ejecutar consultas ni recorrer la red
    // hacia abajo), replicando el patrón a1-a4 de /usuarios: 4 get() sobre
    // documentos DISTINTOS entre sí (el caché del motor solo evita repetir
    // el acceso a un mismo documento).
    //
    // OJO: esAvanzado() es condición NECESARIA. Sin ella, esta función
    // concedería a cualquier usuario registrado (incluso con rol estudiante)
    // la lectura de las finanzas de su downline, y el rol 'avanzado' sería
    // una etiqueta sin efecto real. El AND evalúa primero el rol, así que
    // un usuario que no es avanzado no gasta ningún get() de la cadena.
    //
    // COSTE POR DOCUMENTO EVALUADO (límite duro: 10 accesos por evaluación):
    //   esAvanzado() ...... 1 acceso  (usuarios/{uid}, documento propio)
    //   f1-f4 ............ 4 accesos (cadena de patrocinio del titular)
    //   isAdmin() ......... 1 acceso  (el MISMO usuarios/{uid} → cacheado)
    //   ── TOTAL ..... 5 de 10, con margen para el resto de la expresión.
    function f1() {
      return get(/databases/$(database)/documents/usuarios/$(resource.data.userId)).data.sponsorId;
    }
    function f2() {
      return get(/databases/$(database)/documents/usuarios/$(f1())).data.sponsorId;
    }
    function f3() {
      return get(/databases/$(database)/documents/usuarios/$(f2())).data.sponsorId;
    }
    function f4() {
      return get(/databases/$(database)/documents/usuarios/$(f3())).data.sponsorId;
    }
    function esMiArbolFin() {
      return esAvanzado() && (
        resource.data.userId == request.auth.uid
        || f1() == request.auth.uid
        || f2() == request.auth.uid
        || f3() == request.auth.uid
        || f4() == request.auth.uid
      );
    }
    // ═══ BYPASS TOTAL DE SUPERADMIN ═════════════════════════════
    // isAdmin() (rol superadmin validado contra su documento
    // usuarios/{uid}.rol) se contempla en TODAS las reglas de este
    // archivo (|| isAdmin()): cualquier operación —lectura, escritura,
    // creación, edición, eliminación, asignación de dinero o de
    // comisiones— queda permitida libre e incondicionalmente para el
    // superadmin, sin validaciones de cadenas de patrocinio, parentesco
    // ni límites de asignación.
    // Restricción estricta de pago/registro: solo 'completo' (y legacy
    // 'pago'). Cualquier otro valor, el valor ausente (null) o variaciones
    // de texto NO restringen: se trata como prueba gratuita para visitantes.
    function accesoRestringido(v) {
      return v is string && v.lower() in ['completo', 'pago'];
    }

    /* Documento público por definición: se lee con CUALQUIER identidad, incluida
       la de un visitante sin sesión (esPublico()) y la de una cuenta registrada.
       Se usa solo en las colecciones que la app publica de forma abierta (podcasts
       y referidos); el resto de contenido sigue filtrado por rol.

       Solo esconde el documento un `publicado: false` EXPLÍCITO. La comprobación
       va por el tipo y no por la igualdad porque un campo ausente vale null en las
       reglas y `null == true` es falso: exigir el campo dejaría invisibles a los ojos
       del visitante los documentos recién creados, que es justo cuando el gestor
       quiere ver si ya se publicaron. `!(v is bool)` cubre "sin campo" y el
       `|| v == true` cubre el valor verdadero.

       OJO con `resource == null` al principio: al LEER un documento que todavía
       no existe, `resource` vale null, y `resource.data` sobre null LANZA error.
       En las reglas un error no equivale a false: deniega la petición. Eso rompía
       guardar colecciones nuevas, porque el cliente hace ref.get() para leer el
       campo `creado` antes del ref.set(), y ese get() caía siempre. El atajo con
       `||` evita tocar `.data` cuando no hay documento. */
    function esVisiblePublico() {
      return resource == null
        || !(resource.data.publicado is bool)
        || resource.data.publicado == true;
    }

    /* ── USUARIOS (CRM y perfiles) ─────────────────────────── */
    // Lectura ESTRICTAMENTE AISLADA (red multi-nivel, hasta 5 niveles):
    //   - el propio perfil (uid == sesión),
    //   - descendientes por patrocinio (esMiArbol): Nivel 1 es el hijo
    //     directo (sponsorId == sesión); cada nivel N comprueba subiendo
    //     por la cadena sponsorId que el ancestro (N-1) generaciones
    //     arriba fue referido por la sesión, usando get() (máximo 4
    //     accesos por documento, dentro del límite de las reglas),
    //   - el patrocinador directo propio (uid == sponsorId de mi perfil)
    //     para mostrar "Patrocinado por",
    //   - los patrocinadores ASCENDENTES de la cadena propia (N1–N5,
    //     esMiSponsor): el referido necesita leer su upline para que el
    //     módulo Finanzas calcule y liquide las comisiones de sus aportes
    //     personales (V.mlm.calcularPayload + finanzas_comisiones),
    //   - gestores y superadmin (CRM / gestión de usuarios).
    // Esta regla garantiza que NADIE pueda consultar redes ajenas: la
    // consulta solo devuelve miembros del propio árbol y cualquier
    // lectura puntual de un perfil de terceros queda denegada. Es de
    // SOLO LECTURA para la red: no existe permiso de escritura que no
    // sea el del propio perfil o un administrador.
    match /usuarios/{uid} {
      function esMiPatrocinador() {
        return isRegistered()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.sponsorId == uid;
      }
      // Ancestros del documento por sponsorId, una generación por get().
      // El resultado de cada get() se cachea dentro de la misma evaluación,
      // con lo que un documento de Nivel 5 usa 4 accesos (máximo, bajo el
      // límite de 10 por evaluación de las reglas).
      function a1() {
        return get(/databases/$(database)/documents/usuarios/$(resource.data.sponsorId)).data.sponsorId;
      }
      function a2() {
        return get(/databases/$(database)/documents/usuarios/$(a1())).data.sponsorId;
      }
      function a3() {
        return get(/databases/$(database)/documents/usuarios/$(a2())).data.sponsorId;
      }
      function a4() {
        return get(/databases/$(database)/documents/usuarios/$(a3())).data.sponsorId;
      }
      // El documento es descendiente del usuario en sesión dentro de 5
      // generaciones: el ancestro (N-1) generaciones arriba fue referido
      // directamente por él (su sponsorId es la sesión).
      function esMiArbol() {
        return isRegistered()
          && (resource.data.sponsorId == request.auth.uid
              || a1() == request.auth.uid
              || a2() == request.auth.uid
              || a3() == request.auth.uid
              || a4() == request.auth.uid);
      }
      // Ancestros propios ascendentes (N1–N5): el espejo de a1–a4 pero
      // subiendo desde el usuario en sesión. Permite al referido leer su
      // cadena de patrocinadores para liquidar sus comisiones MLM.
      function m1() {
        return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.sponsorId;
      }
      function m2() {
        return get(/databases/$(database)/documents/usuarios/$(m1())).data.sponsorId;
      }
      function m3() {
        return get(/databases/$(database)/documents/usuarios/$(m2())).data.sponsorId;
      }
      function m4() {
        return get(/databases/$(database)/documents/usuarios/$(m3())).data.sponsorId;
      }
      // El documento leído es uno de los patrocinadores de mi cadena
      // (niveles 1 a 5: el Nivel 5 se extrae del sponsorId de m4()).
      function esMiSponsor() {
        return isRegistered()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && (uid == m1()
              || uid == m2()
              || uid == m3()
              || uid == m4());
      }
      // ─── RED JERÁRQUICA DEL COORDINADOR (Fase A) ────────────
      // El rol 'coordinador_comunidad' consulta SU red (hasta 4 niveles)
      // con UNA sola consulta: where('camino','array-contains',uid). El
      // motor de reglas solo admite esa consulta si la regla se puede
      // PROBAR para todos los documentos devueltos: por eso la rama se
      // apoya en `camino`, un campo que la propia consulta restringe.
      //
      // OJO con el orden de las ramas del allow read: esta va ANTES de
      // esMiArbol() a propósito. Al evaluar una consulta, el motor
      // construye un documento "potencial" con los campos restringidos por
      // la consulta y deja el resto sin valor; las ramas que suben por
      // la cadena de patrocinio (a1–a4) no se pueden evaluar sobre ese
      // documento. Como el `||` es CORTO-CIRCUITO, la rama del coordinador
      // resuelve primero y las demás ni se miran.
      function esMiRedCoordinador() {
        return esCoordinador()
          && resource.data.get('camino', []) is list
          && request.auth.uid in resource.data.get('camino', []);
      }
      allow read: if signedIn()
        && (esMiRedCoordinador()
            || uid == request.auth.uid
            || esMiArbol()
            || esMiPatrocinador()
            || esMiSponsor()
            || isGestor()
            || isAdmin());
      // El dueño puede actualizar su perfil, pero NO puede auto-asignarse el
      // permiso de vendedor: "Vendedor Autorizado" solo lo concede el CRM
      // (isAdmin). En un alta (resource == null) el campo debe venir ausente.
      function noCambiaVendedorAutorizado() {
        return !('vendedorAutorizado' in request.resource.data)
          || (resource != null
              && request.resource.data.vendedorAutorizado == resource.data.get('vendedorAutorizado', false));
      }
      // El CONJUNTO DE ROLES NUNCA lo concede el propio usuario: lo concede
      // el CRM (administrador). Sin esta protección, cualquiera podría
      // escribirse 'superadmin' en su propio documento y heredar el bypass
      // total de todas las reglas de este archivo.
      //   - en el ALTA solo se admite el conjunto por defecto ('estudiante');
      //   - en la ACTUALIZACIÓN los roles no cambian (comparación por
      //     conjunto, no por igualdad de listas del lenguaje de reglas).
      //
      // OJO: el lenguaje de reglas no tiene `if` ni `var`: se usa `let` para
      // declarar y el operador ternario / && para las decisiones.
      function rolesValidosEnAlta() {
        let p = request.resource.data.get('rol', '');
        let r = request.resource.data.get('roles', []);
        return (p == '' || p == 'estudiante')
          && (r is list)
          && (r.size() == 0 || (r.size() == 1 && r[0] == 'estudiante'));
      }
      function rolesIntactosEnUpdate() {
        let rolViejo = resource.data.get('rol', '');
        let rolNuevo = request.resource.data.get('rol', '');
        let viejos = resource.data.get('roles', []);
        let nuevos = request.resource.data.get('roles', []);
        return rolNuevo == rolViejo
          && (viejos is list)
          && (nuevos is list)
          && ((viejos.size() == nuevos.size() && viejos.hasAll(nuevos) && nuevos.hasAll(viejos))
              // Documento heredado (sin `roles`) que materializa su conjunto
              // con el rol principal: se acepta, pero sin añadir roles nuevos.
              || (!('roles' in resource.data)
                  && nuevos.size() <= 1
                  && (nuevos.size() == 0 || (nuevos[0] is string && nuevos[0] == rolViejo))));
      }
      function rolesIntactos() {
        return resource == null ? rolesValidosEnAlta() : rolesIntactosEnUpdate();
      }
      allow write: if signedIn()
        && (isAdmin()
            || (uid == request.auth.uid
                && noCambiaVendedorAutorizado()
                && rolesIntactos()
                && caminoCoherente()));
    }

    /* ── MAPEO DE CÓDIGOS DE REFERIDO (MLM) ────────────────── */
    // Cada documento referidos/{code} solo expone { userId }. La lectura
    // es pública (incluye visitantes sin sesión: permite validar un código
    // de referido antes de registrarse, sin cuenta ni registro fantasma);
    // la escritura queda restringida al dueño del código, ya registrado.
    match /referidos/{code} {
      allow read: if esPublico() || signedIn();
      allow write: if isAdmin() || (isRegistered() && request.resource.data.userId == request.auth.uid);
    }

    /* ── CURSOS Y PROGRESO (CMS jerárquico 4 niveles) ──────── */
    // jerarquía: categorias/{catId} → cursos/{id} → bloques/{bid} → lecciones/{lid}
    //
    // Política de contenido (campo `acceso` en cada nodo):
    //   curso.acceso   = 'gratis' (Nivel 1 · libre/público) |
    //                    'completo' (Nivel 2 · para registrados) |
    //                    'pago' (Nivel 3 · de pago); default 'completo'
    //   bloque.acceso  = 'gratis' | 'completo' | 'pago' (módulo avanzado)
    //   leccion.acceso = 'prueba' (Nivel 1 · el 'gratis' antiguo es el mismo
    //   nivel) | 'completo' (Nivel 2) | 'pago' (Nivel 3)
    //
    // - Catálogo general: lectura PÚBLICA de los metadatos de cursos
    //   publicados y de TODOS sus bloques/módulos (incluye visitantes
    //   sin sesión: esPublico() == request.auth == null). Los visitantes
    //   NO se autentican de forma anónima; navegan sin generar ningún
    //   registro en Firebase Authentication.
    // - Lecciones: policy TOLERANTE para visitantes — se muestra como prueba
    //   gratuita TODO documento cuyo `acceso` NO sea restricción estricta
    //   ('completo'/'pago'), incluidos los que no tienen el campo.
    //   En reglas, un campo ausente vale null y `!=`/`accesoRestringido`
    //   no descartan (a diferencia de las consultas, que SÍ lo hacen; por
    //   eso el cliente une `!= 'completo'` con `== null`).
    // - El filtrado de acceso ocurre SOLO a nivel de lección individual;
    //   los bloques nunca ocultan a un visitante un curso publicado.
    // - Escritura de contenido: exclusiva de gestores/superadmin.
    match /categorias/{catId} {
      allow read: if canManage() || isRegistered() || esPublico();
      allow write: if canManage();

      match /cursos/{id} {
        allow read: if canManage()
          || isRegistered()
          || (esPublico() && resource.data.publicado == true);
        // Gestores y superadmin escriben el curso con libertad total de
        // campos (incluye `catId`/`categoryId` y cualquier otro dato del
        // documento): create/update/delete no están restringidos por campo.
        allow create, update, delete: if canManage();

        match /bloques/{bid} {
          function cursoPublicado() {
            return get(/databases/$(database)/documents/categorias/$(catId)/cursos/$(id)).data.publicado == true;
          }
          // Los bloques SIEMPRE son visibles dentro de un curso publicado,
          // para cualquier sesión: el filtrado de acceso ocurre SOLO a nivel
          // de lección individual (`acceso` del propio documento).
          allow read: if canManage()
            || isRegistered()
            || (esPublico() && cursoPublicado());
          allow write: if canManage();

          match /lecciones/{lid} {
            // FASE A · rol 'cursos_pago': la rama es ADITIVA. El contenido
            // 'pago' que ya leían las cuentas registradas sigue igual (queda
            // para la FASE B la restricción estricta, que exigirá que el
            // cliente filtre por `acceso` en la consulta para que el motor
            // pueda probarla). Con esta rama, el contenido de pago premium
            // queda además disponible para quienes tienen el rol.
            allow read: if canManage()
              || esCursosPago()
              || isRegistered()
              || (esPublico() && cursoPublicado()
                    && !accesoRestringido(resource.data.acceso));
            allow write: if canManage();
          }
        }

        // Progreso del estudiante (subcolección de cada curso):
        // solo el propio usuario registrado lee/escribe su avance. Los
        // visitantes sin sesión NO tienen UID: su navegación es de solo
        // lectura (request.auth == null y g subscribeProg se omite).
        match /progreso/{uid} {
          allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
        }
      }
    }

    // Compatibilidad: cursos antiguos de raíz (cursos/{id}/modulos/…)
    // para migración sin romper el contenido existente.
    match /cursos/{id} {
      allow read: if canManage()
        || isRegistered()
        || (esPublico() && resource.data.publicado == true);
      // Igual política de escritura que los cursos anidados: gestores y
      // superadmin pueden crear/actualizar/eliminar el documento raíz con
      // todos sus campos, incluidos `catId` y `categoryId`, sin restricción.
      allow create, update, delete: if canManage();

      match /modulos/{mid} {
        function cursoPublicado() {
          return get(/databases/$(database)/documents/cursos/$(id)).data.publicado == true;
        }
        // Los módulos SIEMPRE son visibles dentro de un curso publicado,
        // para cualquier sesión: el filtrado de acceso ocurre SOLO a nivel
        // de lección individual (`acceso` del propio documento).
        allow read: if canManage()
          || isRegistered()
          || (esPublico() && cursoPublicado());
        allow write: if canManage();

        match /lecciones/{lid} {
          // Misma política que las lecciones anidadas: el rol 'cursos_pago'
          // suma acceso al contenido premium (Fase A aditiva).
          allow read: if canManage()
            || esCursosPago()
            || isRegistered()
            || (esPublico() && cursoPublicado()
                  && !accesoRestringido(resource.data.acceso));
          allow write: if canManage();
        }
      }

      match /progreso/{uid} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    /* ── PODCASTS · COLECCIONES DE AUDIO (PÚBLICO · NIVEL 1) ───
       Módulo de contenido ABIERTO: el visitante anónimo (sin sesión, esPublico())
       debe poder listar las colecciones y REPRODUCIR los audios sin registros ni
       permisos. Por eso la lectura no es condicional a ningún rol: es la regla más
       laxa del archivo junto a referidos/{code} y config/portal, y a propósito.

       Qué se publica en un documento de estas colecciones: título, descripción,
       portada, orden y la URL del audio. Todo eso es justamente lo que el
       visitante ya ve en pantalla, así que abrir la lectura no expone nada que no
       estuviera a un clic de aparecer. NO se guarda aquí ningún dato personal ni el
       UID de quien edita (por lo que enseguida se explica, eso va en
       superadmin_auditoria): guardar identidad en un documento que cualquiera puede
       leer convertiría la escritura de un gestor en una filtración.

       Estructura:
         podcast_categorias/{catId}                     → clasificación del catálogo
         podcast_colecciones/{colId}                    → la colección (p. ej. un programa)
         podcast_colecciones/{colId}/episodios/{epId}  → los audios de la colección

       Publicación (`publicado`): tolerante a propósito. No se exige el campo, y solo
       un `false` explícito esconde el documento — igual que un curso sin `publicado`
       se considera publicado. Así un documento recién creado por un gestor es visible
       de inmediato, sin marcar una casilla, y un borrador se esconde escribiendo
       `publicado: false`. El cliente usa la MISMA tolerancia (podcasts.js →
       consultas()): une `publicado == true` con `publicado == null`, porque
       `!= false` en una consulta descarta los documentos sin el campo.

       Escritura: exclusiva de gestores y superadmin (canManage()), la misma frontera
       que el resto del contenido del CMS. Nadie más puede crear, reordenar, editar ni
       borrar colecciones, episodios o categorías. */
    match /podcast_categorias/{catId} {
      // canManage() en la LECTURA, no solo en la escritura: sin esta segunda
      // rama la consulta where('publicado','==',false) que monta el módulo al
      // entrar en modo gestor vuelve 403 y el catálogo se queda vacío.
      allow read: if esVisiblePublico() || canManage();
      allow create, update, delete: if canManage();
    }

    match /podcast_colecciones/{colId} {
      // Los borradores son visibles para quien puede gestionarlos y para nadie
      // más: esVisiblePublico() sigue siendo la puerta del visitante anónimo.
      allow read: if esVisiblePublico() || canManage();
      allow create, update, delete: if canManage();

      match /episodios/{epId} {
        // Un episodio hereda la publicación de su colección: aunque el episodio
        // esté marcado como publicado, no se puede escuchar desde una colección
        // oculta. Un solo get() (el documento de la colección) y nada más.
        function coleccionVisible() {
          return get(/databases/$(database)/documents/podcast_colecciones/$(colId)).data.publicado != false;
        }
        // canManage() va delante porque un gestor también tiene que leer los
        // episodios de una colección en borrador, que coleccionVisible() negaría
        // a propósito. Para el resto se exige que la colección esté visible.
        allow read: if canManage() || (esVisiblePublico() && coleccionVisible());
        allow create, update, delete: if canManage();
      }
    }

    /* ── TIENDA CONSOLIDADA · MARKETPLACE (PÚBLICO · NIVEL 1) ──
       Módulo de contenido ABIERTO: el visitante sin sesión (esPublico()) lista
       el catálogo de productos y ve la ficha (precio, % de comisión y datos de
       contacto del vendedor) sin registrarse. Igual que podcasts: abrir la
       lectura no expone nada que no esté ya a un clic de verse en pantalla, y
       NO se guarda aquí ningún dato personal sensible ni el UID de quien edita.

       Estructura:
         tienda_categorias/{catId} → clasificación del catálogo
         tienda_productos/{prodId} → cada producto (con su comisión)
         tienda_vendedores/{uid}   → perfil público del vendedor

       Escritura: cada vendedor gestiona SUS productos y SU perfil (con sesión
       real, vendedorId == request.auth.uid); las categorías y la moderación del
       catálogo quedan en manos de canManage() (gestor/superadmin), la misma
       frontera que el resto del CMS. */
    match /tienda_categorias/{catId} {
      // canManage() en la lectura: la consulta where('publicado','==',false) que
      // monta el módulo al gestionar vuelve 403 sin esta rama.
      allow read: if esVisiblePublico() || canManage();
      allow create, update, delete: if canManage();
    }

    match /tienda_productos/{prodId} {
      // El DUEÑO lee su producto en cualquier estado, incluso borrador, para
      // poder gestionarlo desde "Mi tienda"; el visitante solo lo publicado; el
      // gestor/superadmin, todo. La rama del dueño va sobre resource (el
      // documento ya existente) y es la que autoriza su consulta
      // where('vendedorId','==',uid): Firestore exige que la regla demuestre
      // que toda la consulta es legible.
      allow read: if esVisiblePublico()
        || canManage()
        || (isRegistered() && resource.data.vendedorId == request.auth.uid);
      // Al crear, el producto debe nacer a nombre de quien lo crea (o de un
      // admin). Al editar o borrar solo el dueño o el superadmin.
      allow create: if isRegistered()
        && (request.resource.data.vendedorId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin()
        || (isRegistered() && resource.data.vendedorId == request.auth.uid);
    }

    match /tienda_vendedores/{uid} {
      // Perfil PÚBLICO de la tienda externa (negocio, plataforma, categoría,
      // descripción y URL/embed): lo lee cualquier identidad para que el
      // marketplace funcione sin sesión. La ESCRITURA exige, además de ser el
      // dueño, el permiso explícito "Vendedor Autorizado" que concede el CRM
      // (usuarios/{uid}.vendedorAutorizado). El superadmin mantiene su bypass.
      allow read: if esVisiblePublico() || signedIn();
      allow write: if isAdmin()
        || (isRegistered() && request.auth.uid == uid && esVendedorAutorizado());
    }

    /* ── CONFIG (perfiles organizacionales) ────────────────── */
    // Listas de opciones del CRM (departamentos, ciudades, etc.).
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* ── FICHAS DEL HOME ───────────────────────────────────────
       Colección propia del módulo de Configuración: las fichas que el
       superadmin crea para la portada (título, texto enriquecido, medio
       —imagen o vídeo—, orden y estado de publicación).

       LECTURA: el contenido PUBLICO se lee sin cuenta (esPublico()), igual
       que el catálogo publicado de la tienda o los podcasts: lo que se
       publica en la landing se lee sin cuenta. Se apoya en
       esVisiblePublico() para que un borrador (publicado == false) NO sea
       legible por el visitante: solo lo ve quien puede gestionarlo
       (canManage()).

       La regla se apoya en `publicado` a propósito: el motor de reglas
       solo admite una consulta si puede PROBAR la regla para todos los
       documentos que podrían salir. Por eso la portada consulta con
       where('publicado','==',true) (y así solo llegan las publicadas) y
       el panel de Configuración, que sí puede gestionar, consulta la
       colección entera. Un usuario registrado que no gestiona NO puede
       listar la colección completa: solo le llegan las fichas publicadas.

       ESCRITURA: exclusiva del superadmin (isAdmin()), igual que el resto
       del contenido del CMS. OJO: el comodín /{document=**} del final
       deniega cualquier ruta no declarada, así que sin este bloque las
       fichas NO existirían para nadie.

       CONTRATO: solo puede vivir aquí lo que ya se pinta en la landing
       (texto, medio y orden). NO se guarda el UID de quien lo editó: este
       documento es legible por cualquiera y eso convertiría la escritura
       del superadmin en una filtración. La trazabilidad va en
       superadmin_auditoria. */
    match /fichas/{id} {
      allow read: if esVisiblePublico() || canManage();
      allow create, update, delete: if isAdmin();
    }

    /* ── CONFIG / ESTRUCTURA DE FORMULARIOS ────────────────────
       config/formulario guarda la estructura de los formularios de
       REGISTRO y de PERFIL: qué campos existen y en qué estado
       (obligatorio / visible / oculto / eliminado).

       LECTURA: se abre a esPublico() porque el formulario de REGISTRO lo
       ve el visitante anónimo (puede registrarse sin cuenta previa) y
       necesita saber qué campos se exigen ANTES de enviar el formulario.
       Solo son etiquetas, tipos y estados: no hay ningún dato personal en
       este documento.

       ESCRITURA: exclusiva del superadmin (isAdmin()). El comodín
       /config/{id} de arriba exige isAdmin() también, así que la
       escritura queda cerrada al superadmin por los dos lados. */
    match /config/formulario {
      allow read: if esPublico() || signedIn();
      allow write: if isAdmin();
    }

    /* ── CONFIG PORTAL (ajustes de la landing pública) ───────
       Ajustes que la portada muestra SIN sesión: el video corporativo y los
       TRES TEXTOS de su sección (videoEtiqueta, videoTituloSeccion,
       videoSubtituloSeccion). Su lectura se abre a esPublico() (como el
       catálogo publicado y las lecciones de prueba) porque, si no, la sección
       quedaría vacía para todo visitante que no tenga cuenta.

       La ESCRITURA NO se relaja en absoluto: sigue siendo exclusiva del
       superadmin (isAdmin()), igual que el resto de config y que el
       comodín /config/{id} de arriba. Cualquier intento de(student,
       gestor, avanzado, visitante) se deniega en el servidor, aunque se
       manipule el cliente; la comprobación del rol vive en el documento
       usuarios/{uid}.rol, no en nada que envíe el navegador.

       OJO: las reglas de Firestore se combinan con OR entre los bloques
       que CASAN, así que este bloque y /config/{id} se evalúan ambos para
       config/portal. Como los dos exigen isAdmin() para escribir, el
       resultado sigue siendo superadmin-only.

       CONTRATO DE ESTE DOCUMENTO: es PÚBLICO, luego aquí dentro solo puede
       vivir lo que un visitante sin cuenta ya puede ver en pantalla (la URL,
       el tipo de fuente, el interruptor de publicación, la fecha del último
       cambio y los tres textos de la sección). Los textos van como TEXTO
       PLANO y el cliente los pinta con textContent, nunca como HTML: un
       campo que admitiera marcado sería Injection en la landing. En concreto
       NO se guarda aquí el UID de quien lo editó: sería legible por cualquiera,
       incluidos los visitantes anónimos, y bastaría para identificar la cuenta
       del superadmin. Esa trazabilidad va en superadmin_auditoria, de abajo. */
    match /config/portal {
      allow read: if esPublico() || signedIn();
      allow write: if isAdmin();
    }

    /* ── CONFIG WHATSAPP (número del widget flotante) ─────────
       Un ÚNICO campo: `numero`, el teléfono al que abre la conversación el
       botón verde de la portada. Su lectura se abre a esPublico() por el
       mismo motivo que config/portal: el widget está en la landing y quien
       lo usa es, casi siempre, un visitante SIN sesión. Sin esta rama el
       enlace wa.me/ se quedaría sin número para todo el mundo menos para
       las cuentas registradas, que es justo lo contrario de lo que se
       pretende.

       CONTRATO: solo puede vivir aquí lo que la landing ya pinta en claro
       (un número de teléfono de contacto), y además va TEXTO PLANO que el
       cliente convierte a dígitos antes de montar la URL: nada de HTML y
       nada identificativo de quien lo editó, que sigue sin entrar en un
       documento público (eso va a superadmin_auditoria).

       La ESCRITURA no se relaja: sigue siendo exclusiva de isAdmin(),
       igual que el resto de config y que el comodín /config/{id} de arriba. */
    match /config/whatsapp {
      allow read: if esPublico() || signedIn();
      allow write: if isAdmin();
    }

    /* ── AUDITORÍA DEL SUPER ADMIN ────────────────────────────
       Bitácora de los cambios que solo el superadmin puede hacer (hoy, el
       video corporativo de la portada y el número de WhatsApp de soporte).
       Vive FUERA de `config` a propósito:
       cada bloque de config/{id} abre la lectura a cualquier sesión, y en
       config/portal incluso a visitantes sin cuenta, así que un registro de
       "quién cambió qué" dentro de esa colección sería público.

       Aquí la lectura y la escritura son ambas exclusivas de isAdmin(): ni un
       gestor, ni un avanzado, ni un usuario registrado, ni un visitante
       pueden leer el historial ni borrarlo. Y como no hay ningún otro bloque
       que case con esta ruta, no hay ningún otro permiso que se combine con
       este por OR: el candado es único, no el más laxo de varios. */
    match /superadmin_auditoria/{id} {
      allow read, write: if isAdmin();
    }

    /* Deniega cualquier ruta no declarada arriba. Es la última línea: las
       reglas son permisivas por omisión, así que sin este bloque TODO lo que
       no se nombre explícitamente (escrituras inventadas por un cliente
       manipulado) quedaría permitido. El panel del super admin no lo necesita
       para funcionar, pero lo que protege es justo eso. */
    match /{document=**} {
      allow read, write: if false;
    }

    /* ── COMUNIDADES (solo cuentas registradas) ────────────── */
    // Fuera del catálogo general y de las lecciones de prueba: los
    // visitantes anónimos no pueden entrar en comunidades.
    match /comunidades/{id} {
      allow read: if isAdmin() || isRegistered();
      allow create, update: if isAdmin() || isRegistered();
      allow delete: if isAdmin();
    }
    match /comunidad_miembros/{id} {
      allow read: if isAdmin() || isRegistered();
      allow create, update: if isAdmin() || isRegistered();
      allow delete: if isAdmin();
    }
    match /reuniones/{id} {
      allow read: if isAdmin() || isRegistered();
      allow create, update: if isAdmin() || isRegistered();
      allow delete: if isAdmin();
    }

    /* ── COMUNIDAD CATEGORIAS ─────────────────────────────── */
    // Opciones dinámicas del campo "tipo" de las comunidades.
    // Cualquier usuario autenticado puede leer y escribir.
    match /comunidad_categorias/{categoriaId} {
      allow read, write: if request.auth != null;
    }

    /* ── FINANZAS (Aportes y Ofrendas) ──────────────────────── */
    // ROL AVANZADO (solo lectura): los tres bloques de abajo (transacciones,
    // comisiones y pagos) añaden `|| esMiArbolFin()` a su regla de lectura, de
    // modo que un usuario con rol 'avanzado' consulta los documentos de su
    // PROPIA red (él mismo y hasta 5 niveles por debajo, vía f1–f4). No puede
    // escribir nada: todas las reglas create/update/delete siguen cerradas en
    // isAdmin(), sin bypass. Los porcentajes (config/finanzas) se conservan
    // en config/{id}: solo lectura para cualquier sesión, escritura del
    // superadmin. Reportes Financieros y Red MLM Global no viven en las reglas
    // (se derivan de estas colecciones), por lo que su filtro es de interfaz.
    //
    // ROL CONTABLE (Fase A): el módulo de finanzas pasa a ser territorio de
    // 'contable' (y 'superadmin', que conserva su bypass). El contable lee
    // TODAS las colecciones financieras —no solo las de su red— y lleva el
    // CRUD de transacciones, comisiones, pagos y cuentas bancarias. Es el
    // único rol nuevo con escritura financiera: el avanzado solo lee, y el
    // coordinador y el resto no entran al módulo.
    // La configuración (config/finanzas: finanzasEnabled, porcentajes
    // N1–N5, porcentajeCaja, categorias) queda cubierta por el bloque
    // config/{id}: lectura para cualquier sesión, escritura del
    // superadmin. Colecciones del módulo:
    //   finanzas_transacciones — CRUD CENTRALIZADO del superadmin: puede
    //     crear/editar/eliminar transacciones de CUALQUIER usuario o
    //     comunidad sin restricciones de cadenas de patrocinio (bypass
    //     || isAdmin()). Cada usuario registrado también puede leer las
    //     transacciones donde es titular contable (userId == sesión) y
    //     crear sus propios aportes personales (origen 'usuario' con
    //     userId == sesión, etiqueta "Aporte de Usuario"). Las
    //     transacciones de origen 'comunidad' (etiqueta "Ofrenda de
    //     Comunidad", tipo 'grupo') quedan siempre bajo gestión del
    //     superadmin (create/update/delete) y son legibles por su
    //     titular (userId).
    //   finanzas_comisiones — el usuario lee las suyas; se crean solo
    //     por liquidación. Rutas permitidas: isAdmin() (la liquidación
    //     centralizada del superadmin cubre grupos Y aportes), el propio
    //     coordinador de la comunidad como comisión de nivel 1 de una
    //     ofrenda de grupo (la regla verifica vía get() que la comunidad
    //     lo acredita) o el autor de un aporte personal que liquida las
    //     comisiones N1–N5 de su red (tipo 'aporte'): se exige que cada
    //     comisión credite a un ancestro real de su cadena (esMiAncestro,
    //     hasta 5 generaciones) y que su origenId sea una transacción
    //     propia. La actualización/eliminación es exclusiva de isAdmin().
    match /finanzas_transacciones/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId
            || esMiArbolFin()   // rol avanzado: su propia red (≤5 niveles)
            || esContable()     // rol contable: todas las transacciones
            || isAdmin());
      allow create: if isRegistered()
        && (request.resource.data.userId == request.auth.uid
            || esContable()
            || isAdmin());
      allow update, delete: if esContable() || isAdmin();
    }
    match /finanzas_comisiones/{id} {
      // Ancestros del autor, una generación por get() (path idénticos a
      // m1–m4 de usuarios, cacheados dentro de la misma evaluación): la
      // comisión de nivel 1 va al sponsorId propio; la de nivel N al
      // sponsorId del ancestro N-1. Destinatarios posibles: p1..p5.
      function p1() {
        return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.sponsorId;
      }
      function p2() {
        return get(/databases/$(database)/documents/usuarios/$(p1())).data.sponsorId;
      }
      function p3() {
        return get(/databases/$(database)/documents/usuarios/$(p2())).data.sponsorId;
      }
      function p4() {
        return get(/databases/$(database)/documents/usuarios/$(p3())).data.sponsorId;
      }
      function p5() {
        return get(/databases/$(database)/documents/usuarios/$(p4())).data.sponsorId;
      }
      function esMiAncestro() {
        return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && (request.resource.data.userId == p1()
              || request.resource.data.userId == p2()
              || request.resource.data.userId == p3()
              || request.resource.data.userId == p4()
              || request.resource.data.userId == p5());
      }
      allow read: if isRegistered()
        && (request.auth.uid == resource.data.userId
            || esMiArbolFin()   // rol avanzado: comisiones de su propia red
            || esContable()     // rol contable: todas las comisiones
            || isAdmin());
      allow create: if isRegistered() && (
          isAdmin()
          || esContable()
          || (request.resource.data.userId == request.auth.uid
              && request.resource.data.tipo == 'grupo'
              && request.resource.data.nivel == 1
              && get(/databases/$(database)/documents/comunidades/$(request.resource.data.comunidadId)).data.coordinadorId == request.auth.uid)
          || (request.resource.data.tipo == 'aporte'
              && request.resource.data.userId != request.auth.uid
              && esMiAncestro()
              && get(/databases/$(database)/documents/finanzas_transacciones/$(request.resource.data.origenId)).data.userId == request.auth.uid)
        );
      allow update, delete: if esContable() || isAdmin();
    }
    //   finanzas_pagos — pagos/desembolsos a usuarios desde la Bolsa de
    //     Comisiones (origen 'bolsa', tipo 'comision'). Los registra el
    //     superadmin (create/update/delete) y cada usuario puede leer los
    //     pagos hechos a su favor (userId == sesión). El monto se
    //     descuenta únicamente del saldo de comisiones del usuario y de
    //     la bolsa global; la Caja Mayor no participa.
    match /finanzas_pagos/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId
            || esMiArbolFin()   // rol avanzado: pagos de su propia red
            || esContable()     // rol contable: todos los pagos
            || isAdmin());
      allow create, update, delete: if esContable() || isAdmin();
    }
    //   finanzas_cuentas — catálogo de cuentas bancarias / billeteras del
    //     proyecto. Cada documento tiene SOLO dos campos de negocio:
    //       banco  → texto descriptivo con el tipo (ej. "Bancolombia
    //                Ahorros", "Nequi")
    //       numero → número de cuenta o de billetera
    //     LECTURA: contable y superadmin (Fase A · el módulo de finanzas es
    //     EXCLUSIVO de estos dos roles: el gestor ya no entra al módulo y
    //     tampoco necesita el catálogo; cualquier otro rol queda denegado
    //     por la regla y por el comodín final).
    //     ESCRITURA (crear, editar, eliminar): superadmin y contable. La
    //     comprobación del rol vive en usuarios/{uid}.rol, no en nada que
    //     envíe el navegador.
    match /finanzas_cuentas/{id} {
      allow read: if esContable() || isAdmin();
      allow create, update, delete: if esContable() || isAdmin();
    }

    /* ── CONFIG DE FINANZAS (Fase A · rol contable) ───────────
       config/finanzas guarda el interruptor del módulo (finanzasEnabled),
       los porcentajes de comisión N1–N5, el porcentaje de caja y las
       categorías de aporte.

       LECTURA: cualquier sesión (la necesita el panel de aporte del
       Escritorio, que sigue abierto para todos los miembros) y también el
       contable, que prepara la liquidación.
       ESCRITURA: SOLO el superadmin. Los porcentajes y los interruptores
       son parámetros de la plataforma, no datos contables: el contable
       administra los DATOS OPERATIVOS (finanzas_cuentas y
       finanzas_transacciones), pero no decide la distribución del dinero.
       El bloque comodín config/{id} exige isAdmin() también, así que
       aquí la escritura queda cerrada al superadmin por los dos lados. */
    match /config/finanzas {
      allow read: if signedIn() || esContable();
      allow write: if isAdmin();
    }
  }
}